<Window x:Class="WpfAppMCF8.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppMCF8"
        mc:Ignorable="d"
        Title="Справочники" Height="320" Width="300" Loaded="Window_Loaded">
    <Window.Resources>
        <CollectionViewSource x:Key="kontragentViewSource" d:DesignSource="{d:DesignInstance {x:Type local:Kontragent}, CreateList=True}"/>
    </Window.Resources>
    <Grid DataContext="{StaticResource kontragentViewSource}" Margin="-3,0,-6,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Label Content="Справочник контрагентов" HorizontalAlignment="Left" Margin="37,11,0,0" VerticalAlignment="Top" Width="162" FontWeight="Bold"/>
        <DataGrid x:Name="kontragentDataGrid" AutoGenerateColumns="False" EnableRowVirtualization="True" ItemsSource="{Binding}" Margin="21,33,22,42" RowDetailsVisibilityMode="VisibleWhenSelected">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="idColumn" Binding="{Binding Id}" Header="Id" Width="SizeToHeader"/>
                <DataGridTextColumn x:Name="naimenovanieColumn" Binding="{Binding Naimenovanie}" Header="Naimenovanie" Width="SizeToHeader"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button Content="Save Changes" HorizontalAlignment="Left" Margin="190,255,0,0" VerticalAlignment="Top" Width="80" RenderTransformOrigin="0.463,-0.489" Click="Button_Click_1"/>
        <Button Content="Cancel" HorizontalAlignment="Left" Margin="111,255,0,0" VerticalAlignment="Top" Width="75" Click="Button_Click"/>
        <Button Content="Delete" HorizontalAlignment="Left" Margin="30,255,0,0" VerticalAlignment="Top" Width="75" Click="Button_Click_2"/>

    </Grid>
</Window>
