<Window x:Class="WpfAppMCF8.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppMCF8"
        mc:Ignorable="d"
        Title="Бухгалтерия 1.3(XAML)" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Menu HorizontalAlignment="Left" Height="40" Margin="-1,3,-2,0" VerticalAlignment="Top" Width="795">
            <MenuItem Header="Справочники">
                <MenuItem Header="Контрагенты" Click="MenuItem_Click"/>
                <MenuItem Header="Единицы измерения" Click="MenuItem_Click_1"/>
                <MenuItem Header="Номенклатура" Click="MenuItem_Click_2"/>
            </MenuItem>
            <MenuItem Header="Документы">
                <MenuItem Header="Приходная накладная" Click="MenuItem_Click_3"/>
                <MenuItem Header="Расходная накладная" Click="MenuItem_Click_4"/>
            </MenuItem>
            <MenuItem Header="Отчеты">
                <MenuItem Header="Приходная накладная" Click="MenuItem_Click_5"/>
                <MenuItem Header="Расходная накладная" Click="MenuItem_Click_6"/>
                <MenuItem Header="Приход/расход номенклатуры по контрагентам" Click="MenuItem_Click_7"/>
                <MenuItem Header="Оборотная ведомость" Click="MenuItem_Click_8"/>
            </MenuItem>
                <MenuItem Header="Справка">
                <MenuItem Header="О программе" Click="MenuItem_Click_9"/>
            </MenuItem>
       </Menu>
    </Grid>
</Window>
