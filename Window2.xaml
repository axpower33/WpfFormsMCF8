<Window x:Class="WpfAppMCF8.Window2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppMCF8"
        mc:Ignorable="d"
        Title="Справочники" Height="320" Width="300" Loaded="Window_Loaded">
    <Window.Resources>
        <CollectionViewSource x:Key="edIzmViewSource" d:DesignSource="{d:DesignInstance {x:Type local:EdIzm}, CreateList=True}"/>
    </Window.Resources>
    <Grid DataContext="{StaticResource edIzmViewSource}">
        <DataGrid x:Name="edIzmDataGrid" AutoGenerateColumns="False" EnableRowVirtualization="True" ItemsSource="{Binding}" Margin="9,31,6,37" RowDetailsVisibilityMode="VisibleWhenSelected">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="idColumn" Binding="{Binding Id}" Header="Id" Width="SizeToHeader"/>
                <DataGridTextColumn x:Name="naimenovanieColumn" Binding="{Binding Naimenovanie}" Header="Naimenovanie" Width="SizeToHeader"/>
            </DataGrid.Columns>
        </DataGrid>
        <Label Content="Справочник единиц измерений" HorizontalAlignment="Center" Margin="20,4,73,0" VerticalAlignment="Top" Width="199" FontWeight="Bold"/>
        <Button Content="Save changes" HorizontalAlignment="Left" Margin="194,256,0,0" VerticalAlignment="Top" Width="83" Click="Button_Click"/>
        <Button Content="Cancel" HorizontalAlignment="Left" Margin="109,256,0,0" VerticalAlignment="Top" Width="75" Click="Button_Click_1"/>
        <Button Content="Delete" HorizontalAlignment="Left" Margin="22,256,0,0" VerticalAlignment="Top" Width="75" Click="Button_Click_2"/>

    </Grid>
</Window>
