<Window x:Class="WpfAppMCF8.Window11"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppMCF8"
        xmlns:ReportViewerRDLC="clr-namespace:Microsoft.Reporting.WinForms;assembly=Microsoft.ReportViewer.WinForms"
        mc:Ignorable="d"
        Title="Отчеты" Height="600" Width="800" Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <WindowsFormsHost x:Name="Reprt" Margin="0,42,0,0">
            <ReportViewerRDLC:ReportViewer x:Name="MyReportViewer" ShowRefreshButton="True" ReportRefresh="MyReportViewer_ReportRefresh" />
        </WindowsFormsHost>
        <DatePicker x:Name="fromDate" HorizontalAlignment="Left" Margin="112,10,0,0" VerticalAlignment="Top"/>
        <DatePicker x:Name="toDate" HorizontalAlignment="Left" Margin="360,9,0,0" VerticalAlignment="Top"/>
        <Label Content="Дата начала:" HorizontalAlignment="Left" Margin="24,9,0,0" VerticalAlignment="Top" Width="83" Cursor="None"/>
        <Label Content="Дата окончания:" HorizontalAlignment="Left" Margin="256,9,0,0" VerticalAlignment="Top" Width="101"/>
    </Grid>
</Window>
