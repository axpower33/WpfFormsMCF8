<Window x:Class="WpfAppMCF8.Window3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppMCF8"
        mc:Ignorable="d"
        Title="Справочники" Height="320" Width="450" Loaded="Window_Loaded">
    <Window.Resources>
        <CollectionViewSource x:Key="nomenklaturaViewSource" d:DesignSource="{d:DesignInstance {x:Type local:Nomenklatura}, CreateList=True}"/>
        <CollectionViewSource x:Key="kontragentViewSource" d:DesignSource="{d:DesignInstance {x:Type local:Kontragent}, CreateList=True}"/>
        <CollectionViewSource x:Key="edIzmViewSource" d:DesignSource="{d:DesignInstance {x:Type local:EdIzm}, CreateList=True}"/>
    </Window.Resources>
    <Grid DataContext="{StaticResource nomenklaturaViewSource}">
        <DataGrid x:Name="nomenklaturaDataGrid" AutoGenerateColumns="False" EnableRowVirtualization="True" ItemsSource="{Binding}" Margin="20,33,22,39" RowDetailsVisibilityMode="VisibleWhenSelected" RenderTransformOrigin="0.5,0.5">
            <DataGrid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="0.345"/>
                    <RotateTransform/>
                    <TranslateTransform X="0.476"/>
                </TransformGroup>
            </DataGrid.RenderTransform>
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="idColumn" Binding="{Binding Id}" Header="Id" Width="SizeToHeader"/>
                <DataGridTextColumn x:Name="naimenovanieColumn" Binding="{Binding Naimenovanie}" Header="Naimenovanie" Width="SizeToHeader"/>
                <DataGridComboBoxColumn x:Name="edIzmColumn" ItemsSource="{Binding Source={StaticResource edIzmViewSource}}" Header="Ed Izm" DisplayMemberPath="Naimenovanie" 
                                        SelectedValuePath="Id"
                                        SelectedValueBinding="{Binding EdIzm}" Width="SizeToHeader"/>
                <DataGridComboBoxColumn x:Name="kontragentColumn" ItemsSource="{Binding Source={StaticResource kontragentViewSource}}" Header="Kontragent" DisplayMemberPath="Naimenovanie" 
                                        SelectedValuePath="Id"
                                        SelectedValueBinding="{Binding Kontragent}" Width="SizeToHeader"/>
            </DataGrid.Columns>
        </DataGrid>
        <Label Content="Справочник номенклатуры" HorizontalAlignment="Center" Margin="25,3,0,0" VerticalAlignment="Top" Width="179" FontWeight="Bold"/>
        <Button Content="Save changes" HorizontalAlignment="Left" Margin="324,256,0,0" VerticalAlignment="Top" Width="89" Click="Button_Click"/>
        <Button Content="Cancel" HorizontalAlignment="Left" Margin="240,256,0,0" VerticalAlignment="Top" Width="75" Click="Button_Click_1"/>
        <Button Content="Delete" HorizontalAlignment="Left" Margin="156,256,0,0" VerticalAlignment="Top" Width="75" Click="Button_Click_2"/>
    </Grid>
</Window>
