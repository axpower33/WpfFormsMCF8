<Window x:Class="WpfAppMCF8.Window6"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppMCF8"
        mc:Ignorable="d"
        Title="Список документов" Height="320" Width="450" Loaded="Window_Loaded">
    <Window.Resources>
        <CollectionViewSource x:Key="tableDoc2ViewSource" d:DesignSource="{d:DesignInstance {x:Type local:TableDoc2}, CreateList=True}"/>
        <CollectionViewSource x:Key="kontragentViewSource" d:DesignSource="{d:DesignInstance {x:Type local:Kontragent}, CreateList=True}"/>
    </Window.Resources>
    <Grid DataContext="{StaticResource tableDoc2ViewSource}">
        <DataGrid x:Name="tableDoc2DataGrid" AutoGenerateColumns="False" EnableRowVirtualization="True" ItemsSource="{Binding}" Margin="11,38,9,51" RowDetailsVisibilityMode="VisibleWhenSelected" MouseDoubleClick="tableDoc2DataGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="idColumn" Binding="{Binding Id, Mode=TwoWay}" Header="Id" Width="SizeToHeader"/>
                <DataGridTemplateColumn x:Name="dataDocColumn" Header="Data Doc" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DatePicker SelectedDate="{Binding DataDoc, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn x:Name="nomerDocColumn" Binding="{Binding NomerDoc, Mode=TwoWay}" Header="Nomer Doc" Width="SizeToHeader"/>
                <DataGridComboBoxColumn x:Name="kontragentColumn" ItemsSource="{Binding Source={StaticResource kontragentViewSource}, Mode=OneWay}" Header="Kontragent" DisplayMemberPath="Naimenovanie" 
                                        SelectedValuePath="Id"
                                        SelectedValueBinding="{Binding Kontragent}" Width="SizeToHeader"/>
                <DataGridTextColumn x:Name="uidColumn" Binding="{Binding uid, Mode=TwoWay}" Header="uid" Width="SizeToHeader"/>
            </DataGrid.Columns>
        </DataGrid>
        <Label Content="Список расходных документов" HorizontalAlignment="Center" Margin="20,6,0,0" VerticalAlignment="Top" Width="227" FontWeight="Bold" FontSize="14"/>
        <Button Content="Save changes" HorizontalAlignment="Left" Margin="334,246,0,0" VerticalAlignment="Top" Width="86" Click="Button_Click"/>
        <Button Content="Cancel" HorizontalAlignment="Left" Margin="251,246,0,0" VerticalAlignment="Top" Width="75" Click="Button_Click_1"/>
        <Button Content="Delete" HorizontalAlignment="Left" Margin="169,247,0,0" VerticalAlignment="Top" Width="75" Click="Button_Click_2"/>

    </Grid>
</Window>
